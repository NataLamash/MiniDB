<Window x:Class="MiniDB.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniDB"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Padding="15">

            <DockPanel>

                <TextBlock Text="MiniDB"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Нова база"
                            Width="110"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="NewDatabase_Click"/>

                    <Button Content="Відкрити"
                            Width="100"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="OpenDatabase_Click"/>

                    <Button Content="Зберегти"
                            Width="100"
                            Height="36"
                            Click="SaveDatabase_Click"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Основна область -->
        <Grid Grid.Row="1"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Таблиці -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Таблиці"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="TablesListBox"
                             Grid.Row="1"
                             FontSize="15"
                             SelectionChanged="TablesListBox_SelectionChanged"/>

                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0">

                        <Button Content="+ Створити таблицю"
                                Height="36"
                                Margin="0,0,0,6"
                                Click="CreateTable_Click"/>

                        <Button Content="Видалити таблицю"
                                Height="36"
                                Click="DeleteTable_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Таблиця -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CurrentTableText"
                               Text="Оберіть таблицю"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="TableDataGrid"
          Grid.Row="1"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserSortColumns="False"
          CanUserReorderColumns="False"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          CurrentCellChanged="TableDataGrid_CurrentCellChanged"
          HeadersVisibility="All"
          GridLinesVisibility="All"/>      

                </Grid>

            </Border>

        </Grid>

        <!-- Нижня панель -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0"
                Padding="15">

            <DockPanel>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Додати рядок"
                            Width="110"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="AddRow_Click"/>

                    <Button Content="Редагувати рядок"
                            Width="130"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="EditRow_Click"/>

                    <Button Content="Видалити рядок"
                            Width="120"
                            Height="36"
                            Margin="0,0,25,0"
                            Click="DeleteRow_Click"/>

                    <Button Content="Перейменувати колонку"
                            Width="175"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="RenameColumn_Click"/>

                    <Button Content="Переставити колонку"
                            Width="165"
                            Height="36"
                            Click="MoveColumn_Click"/>

                </StackPanel>

                <TextBlock x:Name="DatabaseNameText"
                           Text="База не створена"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="Gray"/>

            </DockPanel>

        </Border>

    </Grid>
</Window>
